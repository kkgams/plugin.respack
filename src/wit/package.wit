package gams:respack@1.0.0;

interface respack {
    /// Generate Odin decoder source from schema JSON.
    generate-odin: func(schema: string) -> result<string, string>;

    /// Build packed RSPK bytes from schema JSON and slot payloads JSON.
    ///
    /// `slots-json` is a JSON array whose entries correspond to data slots. Bytes
    /// values must be base64 strings in the slot JSON.
    build: func(schema: string, slots-json: string) -> result<list<u8>, string>;

    /// Build packed RSPK bytes and write them directly through WASI filesystem.
    /// This avoids transporting large byte arrays through scripting/JSON bridges.
    build-to-file: func(schema: string, slots-json: string, path: string) -> result<u64, string>;
}

world respack-plugin {
    import wasi:filesystem/types@0.2.0;
    import wasi:filesystem/preopens@0.2.0;

    export respack;
}
